From 6731a7976de98e4ecc1c2d709a7568c3e397125f Mon Sep 17 00:00:00 2001
From: Tim auf der Landwehr <tadl-git@taufderl.de>
Date: Sat, 10 Oct 2026 00:18:59 +0200
Subject: [PATCH] drm/msm/mdss: stop the bootloader's scanout before resetting
 MDSS

A bootloader that shows a splash leaves a video-mode interface scanning
out of DDR when Linux probes the MDSS. msm_mdss_init() then asserts the
MDSS core reset with that fetch still running. On the Fairphone 4
(SM7225) this hangs the whole SoC on roughly one boot in four: nothing is
logged after "really_probe: probing driver msm-mdss", and the watchdog
eventually drops the phone into the Qualcomm ramdump. Removing the reset
avoids the hang (20 of 20 boots) but leaves the panel dead, so the reset
itself is needed.

Before the reset, turn on the MDSS clocks, disable every INTF timing
engine the bootloader left enabled and wait for the disable to latch at a
frame boundary, the same wait the video encoder's own disable path does.
The reset then lands on an idle MDP.

Signed-off-by: Tim auf der Landwehr <tadl-git@taufderl.de>
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c | 77 +++++++++++++++++++++++++
 drivers/gpu/drm/msm/msm_kms.h           |  6 ++
 drivers/gpu/drm/msm/msm_mdss.c          | 19 ++++--
 3 files changed, 98 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
index da3556eb6ecc..ecc896e83671 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -11,6 +11,7 @@
 
 #include <linux/debugfs.h>
 #include <linux/dma-buf.h>
+#include <linux/of_address.h>
 #include <linux/of_irq.h>
 #include <linux/pm_opp.h>
 
@@ -1518,6 +1519,82 @@ static const struct of_device_id dpu_dt_match[] = {
 };
 MODULE_DEVICE_TABLE(of, dpu_dt_match);
 
+/* Offsets inside an INTF block, as in dpu_hw_intf.c */
+#define DPU_INTF_TIMING_ENGINE_EN	0x000
+#define DPU_INTF_FRAME_COUNT		0x0ac
+
+/**
+ * dpu_quiesce_bootloader_scanout() - stop timing engines left on by firmware
+ * @mdss_dev: the MDSS device whose DPU child is to be quiesced
+ *
+ * A bootloader showing a splash leaves a video-mode interface scanning out a
+ * framebuffer, so the MDP keeps fetching from DDR. Asserting the MDSS core
+ * reset while such a fetch is in flight can wedge the interconnect and hang
+ * the whole SoC. Disable every running timing engine first and wait for the
+ * disable to latch at a frame boundary (as the video encoder's own disable
+ * path does), so the reset lands on an idle MDP.
+ *
+ * The caller must have the MDSS clocks enabled.
+ */
+void dpu_quiesce_bootloader_scanout(struct device *mdss_dev)
+{
+	const struct of_device_id *match = NULL;
+	const struct dpu_mdss_cfg *cfg;
+	struct device_node *np;
+	void __iomem *mmio;
+	u32 fc_before[INTF_MAX] = {};
+	bool running[INTF_MAX] = {};
+	bool stopped = false;
+	int i, idx;
+
+	for_each_available_child_of_node(mdss_dev->of_node, np) {
+		match = of_match_node(dpu_dt_match, np);
+		if (match)
+			break;
+	}
+	if (!match)
+		return;
+
+	cfg = match->data;
+	idx = of_property_match_string(np, "reg-names", "mdp");
+	mmio = of_iomap(np, idx < 0 ? 0 : idx);
+	of_node_put(np);
+	if (!mmio)
+		return;
+
+	for (i = 0; i < cfg->intf_count && i < INTF_MAX; i++) {
+		void __iomem *intf = mmio + cfg->intf[i].base;
+
+		if (!(readl_relaxed(intf + DPU_INTF_TIMING_ENGINE_EN) & BIT(0)))
+			continue;
+		running[i] = true;
+		fc_before[i] = readl_relaxed(intf + DPU_INTF_FRAME_COUNT);
+		writel_relaxed(0, intf + DPU_INTF_TIMING_ENGINE_EN);
+		stopped = true;
+	}
+
+	if (stopped) {
+		/* Two frames at 30 Hz: the disable latches at the next vsync */
+		wmb();
+		msleep(70);
+		for (i = 0; i < cfg->intf_count && i < INTF_MAX; i++) {
+			void __iomem *intf = mmio + cfg->intf[i].base;
+			u32 fc1, fc2;
+
+			if (!running[i])
+				continue;
+			fc1 = readl_relaxed(intf + DPU_INTF_FRAME_COUNT);
+			msleep(20);
+			fc2 = readl_relaxed(intf + DPU_INTF_FRAME_COUNT);
+			dev_info(mdss_dev, "stopped bootloader scanout on %s (frame count %u -> %u, %s)\n",
+				 cfg->intf[i].name, fc_before[i], fc2,
+				 fc1 == fc2 ? "idle" : "STILL RUNNING");
+		}
+	}
+
+	iounmap(mmio);
+}
+
 static struct platform_driver dpu_driver = {
 	.probe = dpu_dev_probe,
 	.remove = dpu_dev_remove,
diff --git a/drivers/gpu/drm/msm/msm_kms.h b/drivers/gpu/drm/msm/msm_kms.h
index f25b31e502d2..abd41a2d22ee 100644
--- a/drivers/gpu/drm/msm/msm_kms.h
+++ b/drivers/gpu/drm/msm/msm_kms.h
@@ -240,4 +240,10 @@ static inline void msm_drm_kms_uninit(struct device *dev)
 
 #endif
 
+#ifdef CONFIG_DRM_MSM_DPU
+void dpu_quiesce_bootloader_scanout(struct device *mdss_dev);
+#else
+static inline void dpu_quiesce_bootloader_scanout(struct device *mdss_dev) {}
+#endif
+
 #endif /* __MSM_KMS_H__ */
diff --git a/drivers/gpu/drm/msm/msm_mdss.c b/drivers/gpu/drm/msm/msm_mdss.c
index 9087c4b290db..818bdcc02474 100644
--- a/drivers/gpu/drm/msm/msm_mdss.c
+++ b/drivers/gpu/drm/msm/msm_mdss.c
@@ -369,10 +369,6 @@ static struct msm_mdss *msm_mdss_init(struct platform_device *pdev, bool is_mdp5
 	int ret;
 	int irq;
 
-	ret = msm_mdss_reset(&pdev->dev);
-	if (ret)
-		return ERR_PTR(ret);
-
 	msm_mdss = devm_kzalloc(&pdev->dev, sizeof(*msm_mdss), GFP_KERNEL);
 	if (!msm_mdss)
 		return ERR_PTR(-ENOMEM);
@@ -408,6 +404,21 @@ static struct msm_mdss *msm_mdss_init(struct platform_device *pdev, bool is_mdp5
 	msm_mdss->num_clocks = ret;
 	msm_mdss->is_mdp5 = is_mdp5;
 
+	/*
+	 * Reset only once any scanout the bootloader left running is stopped:
+	 * asserting the core reset under a live fetch can hang the SoC. The
+	 * clocks must be on to reach the DPU registers.
+	 */
+	ret = clk_bulk_prepare_enable(msm_mdss->num_clocks, msm_mdss->clocks);
+	if (ret)
+		return ERR_PTR(ret);
+	if (!is_mdp5)
+		dpu_quiesce_bootloader_scanout(&pdev->dev);
+	ret = msm_mdss_reset(&pdev->dev);
+	clk_bulk_disable_unprepare(msm_mdss->num_clocks, msm_mdss->clocks);
+	if (ret)
+		return ERR_PTR(ret);
+
 	msm_mdss->dev = &pdev->dev;
 
 	irq = platform_get_irq(pdev, 0);
-- 
2.55.0

